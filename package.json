{
  "name": "news-dashboard",
  "version": "2.0.0",
  "description": "Ambient fullscreen news dashboard for a second monitor. React + TypeScript tiles that continuously cycle live headlines across 9 categories.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/server.js",
    "build": "tsc --noEmit && vite build",
    "build:data": "node scripts/generate-data.js",
    "preview": "vite preview",
    "start": "node server/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "express": "^4.21.2",
    "google-news-url-decoder": "^1.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
